{
  "uid": "ai-activity",
  "title": "AI Activity — Ollama Gateway Audit",
  "tags": ["aiops", "gateway"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requests by user",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (user) (rate(ai_gateway_requests_total[5m])) * 60",
          "legendFormat": "{{user}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqpm" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Requests by model",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (model) (increase(ai_gateway_requests_total[$__range]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Errors (non-2xx)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(ai_gateway_requests_total{status!~\"2..\"}[$__range]))",
          "legendFormat": "errors"
        }
      ],
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ] } },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Latency p50 / p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "ai_gateway_request_duration_seconds{quantile=\"0.5\"}", "legendFormat": "p50 {{path}}" },
        { "expr": "ai_gateway_request_duration_seconds{quantile=\"0.95\"}", "legendFormat": "p95 {{path}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Tokens generated per model (eval_count)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (model) (max_over_time({job=\"ai-gateway-audit\"} | json | unwrap usage_eval_count [$__interval]))",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Audit log — prompts & responses",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "targets": [
        { "expr": "{job=\"ai-gateway-audit\", path=~\"/api/(generate|chat)\"}", "derivedFields": [] }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    }
  ]
}
